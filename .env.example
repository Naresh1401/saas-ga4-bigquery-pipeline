# ── GA4 → BigQuery SaaS Pipeline ──────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file itself.

# GCP / BigQuery
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=ga4_analytics
BQ_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# dbt
DBT_PROFILES_DIR=./dbt

# Airflow
AIRFLOW_HOME=./airflow_home
AIRFLOW__CORE__DAGS_FOLDER=./dags

# SendGrid (daily email alerts)
SENDGRID_API_KEY=SG.xxxxxxx
ALERT_EMAIL_TO=marketing-team@yourcompany.com
ALERT_EMAIL_FROM=data-alerts@yourcompany.com

# Slack (pipeline failure alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# PQL
PQL_THRESHOLD=8.0
